# Files git should never track: Python caches, virtualenvs, local reports and secrets.
__pycache__/
*.pyc
.venv/
.pytest_cache/
bin/
reports/
.env
*.kubeconfig
aws-login.sh
.cache/
.mlflow/
mlflow.db
mlruns/

# Half-finished eval recordings (evals/cassette.py swaps them in only when complete).
*.partial/

# The audit log is runtime data from your own cluster: it stays on your machine.
audit/
# Terraform: provider downloads and local state (the bootstrap stack's state is local on purpose)
.terraform/
*.tfstate
*.tfstate.*
